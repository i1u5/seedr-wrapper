{
  "name": "seedr-cli",
  "version": "2.0.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "start": "deno run -A src/mod.ts",
    "dev": "deno run -A --watch src/mod.ts"
  },
  "imports": {
    "react": "npm:react@18.3.1",
    "ink": "npm:ink@5.1.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "auto",
  "fmt": { "lineWidth": 100, "semiColons": true }
}
